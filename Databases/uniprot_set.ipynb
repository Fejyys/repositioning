   "source": [
    "import pandas as pd\n",
    "import json\n",
    "df = pd.read_csv(\"merged.csv\")\n",
    "\n",
    "f = set([x.split('-')[0] for x in df[\"Uniprot_B\"].tolist()])\n",
    "g = set([x.split('-')[0] for x in df[\"Uniprot_A\"].tolist()])\n",
    "f = f.union(g)\n",
    "with open(\"uniprot_ids.txt\", \"w\") as file:\n",
    "    json.dump(list(f),file)"
   ]
